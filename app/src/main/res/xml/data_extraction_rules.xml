<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12（API 31）及以上的备份 / 换机迁移规则：同样排除可重新下载的离线整集。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="offline/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="offline/" />
    </device-transfer>
</data-extraction-rules>
